LAB_IF=en13
LAB_IP=192.168.10.1
LAB_MASK=255.255.255.0
LAB_NET=192.168.10.0/24
PF_ANCHOR=com.apple/lab-nat
PF_TOKEN_FILE=/var/run/lab-net.pf-token
DNSMASQ_PID_FILE=/var/run/lab-net.dnsmasq.pid
DNSMASQ_BIN=/opt/homebrew/sbin/dnsmasq
DNSMASQ_CONF=network/dnsmasq.conf
# Builds after v2.0.0 negotiate TLS 1.3, which fails against pxe.factory.talos.dev.
IPXE_URL=https://github.com/ipxe/ipxe/releases/download/v2.0.0/ipxeboot.tar.gz

lab_net_service_for_if() {
  networksetup -listnetworkserviceorder | awk -v dev="$1" '
    /^\([0-9*]+\) / { sub(/^\([0-9*]+\) /, ""); name = $0; next }
    $0 ~ "Device: " dev "\\)$" { print name; found = 1; exit }
    END { exit !found }'
}

lab_net_stop_dnsmasq() {
  local pid
  pid="$(cat "$DNSMASQ_PID_FILE" 2>/dev/null || true)"
  if [[ -n "$pid" ]] && kill "$pid" 2>/dev/null; then
    for _ in $(seq 1 30); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done
  fi
  rm -f "$DNSMASQ_PID_FILE"
}
